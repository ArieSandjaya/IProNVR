<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>IproNvrTool</RootNamespace>
    <AssemblyName>IproNvrTool</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ApplicationIcon>6296844.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Server adalah proyek terpisah (Server/IproNvrServer) -->
    <Compile Remove="Server\**" />
    <EmbeddedResource Include="Fonts\*.ttf" />
    <EmbeddedResource Remove="Server\**" />
    <None Remove="Server\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="6296844.ico" />
    <EmbeddedResource Include="6296844.ico" LogicalName="IproNvrTool.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite untuk Daftar NVR (restore otomatis oleh Visual Studio; butuh internet saat build pertama) -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
  </ItemGroup>

  <ItemGroup>
    <!-- LibVLC: dekoder live GPU. Di-restore otomatis oleh Visual Studio (butuh internet saat build pertama; library asli ~150 MB masuk ke folder libvlc di output). -->
    <PackageReference Include="LibVLCSharp" Version="3.8.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
  </ItemGroup>

</Project>
