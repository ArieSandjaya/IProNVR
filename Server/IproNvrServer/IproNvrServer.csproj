<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>IproNvrServer</RootNamespace>
    <AssemblyName>IproNvrServer</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ApplicationIcon>6296844.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <!-- kode deteksi RTSP dipakai bersama dengan aplikasi client -->
    <Compile Include="..\..\RtspDiscovery.cs" Link="Shared\RtspDiscovery.cs" />
    <Compile Include="..\..\StreamProbe.cs" Link="Shared\StreamProbe.cs" />
    <Compile Include="..\..\BrandCgi.cs" Link="Shared\BrandCgi.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="6296844.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="admin.html" LogicalName="IproNvrServer.admin.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
  </ItemGroup>

</Project>
